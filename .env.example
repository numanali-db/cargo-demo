# Cargo Yield Agent — deploy-time configuration
#
# 1. Copy this file to `.env`:        cp .env.example .env
# 2. Fill in values for your workspace.
# 3. Render config files:              ./scripts/render.sh
# 4. Follow the deployment steps in README.md.
#
# `.env` is gitignored. Do not commit secrets.

# ---------- Workspace identifiers ----------

# Unity Catalog name. Created by sql/01_setup_catalog.sql. All bronze/silver/gold/ai schemas live here.
CATALOG=cargo_demo

# SQL warehouse ID used by the app, build_agent.py, and any CLI SQL runs.
# Get from: databricks warehouses list
WAREHOUSE_ID=

# Vector Search endpoint that hosts the knowledge base index. Must already exist.
# Create with: databricks vector-search endpoints create --name <name> --endpoint-type STANDARD
VS_ENDPOINT=

# Foundation Model API serving endpoint used by the agent for rationale drafting.
# Examples: databricks-claude-sonnet-4-6, databricks-meta-llama-3-3-70b-instruct
LLM_ENDPOINT=databricks-claude-sonnet-4-6

# Genie space ID for the in-app analytics chat. Optional — leave blank to disable.
# Get from the URL of your Genie space: /genie/rooms/<space-id>
GENIE_SPACE_ID=

# ---------- Endpoint + app names ----------

# Model Serving endpoint names (also become MLflow registered model aliases).
YIELD_MODEL_ENDPOINT=cargo-yield-model
AGENT_ENDPOINT=cargo-yield-agent

# Databricks App name (must be unique within the workspace).
APP_NAME=cargo-yield-agent

# ---------- App service principal ----------

# OAuth client ID of the app's service principal. Used in sql/05_grant_app_perms.sql.
# Get after step 7: databricks apps get $APP_NAME | grep service_principal_client_id
# Re-run scripts/render.sh and sql/05 after deploying the app the first time.
APP_SP_ID=
